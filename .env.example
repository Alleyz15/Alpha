# This file IS committed to GitHub - variable names only, no real values.
# After cloning: cp .env.example .env, then fill in the values.


# ============================================
# FRONTEND - variables prefixed with VITE_ are bundled into the browser.
# Anyone can read them via DevTools, so only put public values here.
# ============================================

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# The anon key is designed to be public.
# WARNING: only safe if Row Level Security (RLS) is enabled on your tables.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...


# ============================================
# BACKEND ONLY - never add the VITE_ prefix to anything below.
# Adding it would expose these to the public.
# ============================================

# Base mainnet RPC (free Alchemy key)
THETANUTS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Burner wallet private key.
# Use a brand new wallet holding only a few USDC and cents of ETH for gas.
THETANUTS_PRIVATE_KEY=0x...

# Supabase service role key - bypasses all RLS policies. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...