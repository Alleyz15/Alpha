# This file IS committed to GitHub - variable names only, no real values.
# After cloning: cp .env.example .env, then fill in the values.
# Ask a teammate for the values in a DM - never post keys in the group chat.
#
# One file for the whole project. The backend reads it via
# --env-file-if-exists=../.env; Vite reads the VITE_ prefixed lines.


# ============================================
# Backend only - never prefix any of these with VITE_
# ============================================

# --- Supabase ---
# New API key format (sb_secret_). The legacy anon and service_role
# JWT keys are deprecated by the end of 2026.

SUPABASE_URL=

# Secret key - bypasses ALL Row Level Security policies.
# Server-side only. Never expose to a browser.
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_). NOT a secret and NOT needed to run the
# app - the frontend never talks to Supabase directly. Optional, and used only
# by `node scripts/db-check.js` to prove an anonymous client is locked out of
# every table. Without it that one check is skipped.
SUPABASE_PUBLISHABLE_KEY=

# --- Thetanuts / Base mainnet ---

# Free Alchemy key. Do not use the public Base endpoint - it times out
# randomly and the failures look like bugs in your own code.
THETANUTS_RPC_URL=

# Burner wallet private key. A dedicated burner, never a personal wallet.
# Holds only a few USDC and cents of ETH for gas.
THETANUTS_PRIVATE_KEY=

# Optional: the burner's PUBLIC address (not a secret). Lets read-only tools like
# scripts/reconcile.js run without the private key. If unset, the address is
# derived from THETANUTS_PRIVATE_KEY.
THETANUTS_WALLET_ADDRESS=

# --- Safety limits (BR-33, BR-34) ---
# In the environment so they can be tightened without a code review.

MAX_PREMIUM_PER_FILL_USDC=5
MAX_FILLS_PER_DAY=10
QUOTE_VALIDITY_SECONDS=60

# How long an operator may execute a purchase the user already confirmed.
# A SEPARATE window from QUOTE_VALIDITY_SECONDS because they answer different
# questions: validity is "is what we are showing this user still true?", this is
# "is the price we execute at still what they agreed to?".
# Only defensible because the price check (PRICE_TOLERANCE_PCT) is real - if that
# check were ever weakened, the clock would have to come back.
FILL_AUTHORISATION_MINUTES=10
PRICE_TOLERANCE_PCT=5
SCHEDULER_INTERVAL_MINUTES=60
DEFAULT_PROTECTION_PCT=20

# --- Lending (Phase 7) - BR-39 ---
# Annual interest rate charged on USDC loans, percent.
# The credit limit is NOT here - it comes from the filled put's strike.

LOAN_INTEREST_RATE_ANNUAL_PCT=5

# --- Vault (Phase 8) - BR-37, BR-38 ---
# SIMULATED yield rate. Not a real integration.
# The interface must label this as simulated (BR-37).

VAULT_SIMULATED_YIELD_ANNUAL_PCT=5

# Cannot exceed ~26 - the longest BUYABLE expiry (BR-52).
# The raw book shows 62 days but none of it is fillable on our side.
VAULT_TERM_DAYS=26

# Participation rate is NOT here - it is computed from the premium
# actually paid and stored on the row (BR-38, BR-40).

PORT=3000


# ============================================
# Frontend - VITE_ prefixed variables are bundled into the browser
# and readable by anyone. Only public values belong here.
# ============================================

# Use sample frontend data while the backend API is unfinished.
# Set this to false after the backend is running.
VITE_USE_MOCK_API=true

VITE_API_BASE_URL=http://localhost:3000

# NOT USED - the frontend talks to our backend API, not to Supabase directly.
# Kept in case we ever switch to direct frontend access.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
